{
  "name": "taxi-grahovo-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "still": "remotion still src/index.ts TaxiGrahovoPromo",
    "render": "remotion render src/index.ts TaxiGrahovoPromo out/taxi-grahovo-promo.mp4",
