{
  "expo": {
    "name": "Такси Грахово",
    "slug": "taxi-grahovo",
    "version": "1.0.14",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "scheme": "taxigrahovo",
    "userInterfaceStyle": "light",
    "description": "Заказ местного такси в Грахово и поездок по Удмуртии.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.grahovo.taxi",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Геолокация нужна пассажиру для выбора точки подачи, а водителю — для маршрута и ведения по активной поездке.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Для водителя геолокация продолжает работать в фоне только во время смены и активных заказов.",
        "NSUserNotificationsUsageDescription": "Уведомления сообщают о статусе поездки и новых сообщениях водителя или пассажира."
      }
    },
    "android": {
      "package": "ru.grahovo.taxi",
      "versionCode": 34,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6C945",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png",
      "name": "Такси Грахово",
      "shortName": "Такси Грахово",
      "display": "standalone",
      "themeColor": "#F6C945",
      "backgroundColor": "#F7F4EB",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Manrope.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-android-app-optimization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите выбрать фотографию для аватара профиля или отправки в чате.",
          "cameraPermission": "Разрешите использовать камеру, чтобы фотографировать и отправлять снимки в чате.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6C945",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна пассажиру для выбора точки подачи, а водителю — для маршрута и ведения по активной поездке.",
          "locationAlwaysAndWhenInUsePermission": "Для водителя геолокация продолжает работать в фоне только во время смены и активных заказов.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Разрешите использовать Face ID для защиты входа в Такси Грахово."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/android-monochrome.png",
          "color": "#F6C945",
          "defaultChannel": "ride-taxi-found-v2",
          "sounds": [
            "./assets/sounds/taxi_found.wav",
            "./assets/sounds/driver_arriving.wav",
            "./assets/sounds/driver_arrived.wav",
            "./assets/sounds/new_order.wav",
            "./assets/sounds/ride_started.wav",
            "./assets/sounds/ride_complete.wav",
            "./assets/sounds/ride_cancelled.wav",
            "./assets/sounds/chat_message.wav",
            "./assets/sounds/order_updated.wav",
            "./assets/sounds/notification.wav",
            "./assets/sounds/searching.wav",
            "./assets/sounds/driver_released.wav",
            "./assets/sounds/search_timeout.wav",
            "./assets/sounds/passenger_cancelled.wav",
            "./assets/sounds/admin_cancelled.wav",
            "./assets/sounds/taxi_found_queued.wav",
            "./assets/sounds/order_accepted.wav",
            "./assets/sounds/order_accepted_queued.wav",
            "./assets/sounds/next_order_ready.wav",
            "./assets/sounds/driver_departed.wav",
            "./assets/sounds/driver_waiting.wav",
            "./assets/sounds/order_released.wav",
            "./assets/sounds/ride_complete_cash.wav",
            "./assets/sounds/ride_complete_transfer.wav",
            "./assets/sounds/driver_complete_cash.wav",
            "./assets/sounds/driver_complete_transfer.wav",
            "./assets/sounds/driver_complete.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "92f8301d-08c0-44bb-874a-68d1f1fb6ec0"
      },
      "router": {}
    },
    "owner": "romkadvayha"
  }
}
