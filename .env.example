# Client-safe values. Restrict the Yandex key by domain/package in the Yandex dashboard.
EXPO_PUBLIC_API_URL=http://localhost:4100
EXPO_PUBLIC_SOCKET_URL=http://localhost:4100
EXPO_PUBLIC_YANDEX_MAPS_API_KEY=your-yandex-js-api-key
EXPO_PUBLIC_SITE_URL=https://taxigr.ru
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_VK_COMMUNITY_ID=
EAS_PROJECT_ID=

# Public legal details shown in agreements. Fill every value before commercial launch.
EXPO_PUBLIC_OPERATOR_LEGAL_NAME=
EXPO_PUBLIC_OPERATOR_STATUS=
EXPO_PUBLIC_OPERATOR_INN=
EXPO_PUBLIC_OPERATOR_REGISTRATION_NUMBER=
EXPO_PUBLIC_OPERATOR_ADDRESS=
EXPO_PUBLIC_OPERATOR_EMAIL=support@taxigr.ru
EXPO_PUBLIC_OPERATOR_PHONE=
EXPO_PUBLIC_TAXI_REGISTRY_NUMBER=

# Server-only values. Never prefix secrets with EXPO_PUBLIC_.
PORT=4100
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MYSQL_URL=mysql://taxi:change-me@127.0.0.1:3306/taxi_grahovo
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://localhost:8081
ROUTER_BASE_URL=https://router.project-osrm.org
ROUTER_TIMEOUT_MS=2500
ROUTER_CACHE_TTL_SECONDS=600
ROUTER_CACHE_MAX_ENTRIES=2000
ROUTER_CIRCUIT_BREAKER_SECONDS=30
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_CACHE_TTL_DAYS=30
SUPERADMIN_PHONES=
EXPO_ACCESS_TOKEN=
# Browser Web Push. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@taxigr.ru

# Phone confirmation. Console returns a test SMS code only outside production.
SMS_PROVIDER=console
NOTIFICORE_API_KEY=
# Optional ready-to-use API v2 token. If empty, the server obtains it using the API key.
NOTIFICORE_BEARER_TOKEN=
NOTIFICORE_TEMPLATE_ID=271
# Optional approved sender name (up to 11 characters).
NOTIFICORE_ORIGINATOR=

# MAX bot. Subscribe the webhook to bot_started, message_created and message_callback.
MAX_BOT_USERNAME=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# Telegram bot. Set the webhook with allowed_updates=["message","callback_query"].
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=-1004215180973
TELEGRAM_CRITICAL_CHAT_ID=-1004442605510
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_UPDATE_MODE=webhook
# Optional authenticated HTTP(S) proxy used only for outgoing Telegram Bot API calls.
TELEGRAM_PROXY_URL=

# VK ID + community bot. Callback URL: https://api.example.ru/v1/webhooks/vk
VK_APP_ID=
VK_REDIRECT_URI=https://api.example.ru/v1/auth/vk/callback
# VK Mini Apps. The protected key stays server-side and must never use EXPO_PUBLIC_.
VK_MINI_APP_ID=
VK_MINI_APP_SECRET=
VK_MINI_APP_MAX_AGE_SECONDS=900
VK_COMMUNITY_ID=
VK_BOT_TOKEN=
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION=
VK_API_VERSION=5.199
PHONE_CODE_TTL_MINUTES=10
PHONE_CODE_RESEND_SECONDS=180
TRUST_PROXY_HOPS=1
AUTH_ATTEMPT_RETENTION_DAYS=30
GLOBAL_RATE_LIMIT_MAX=10000
