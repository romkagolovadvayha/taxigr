FROM node:24-alpine AS build

WORKDIR /app
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_SOCKET_URL
ARG EXPO_PUBLIC_MAP_TILES_URL
ARG EXPO_PUBLIC_MAP_GLYPHS_URL
ARG EXPO_PUBLIC_SITE_URL
ARG EXPO_PUBLIC_DEMO_MODE=false
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_SOCKET_URL=$EXPO_PUBLIC_SOCKET_URL
ENV EXPO_PUBLIC_MAP_TILES_URL=$EXPO_PUBLIC_MAP_TILES_URL
ENV EXPO_PUBLIC_MAP_GLYPHS_URL=$EXPO_PUBLIC_MAP_GLYPHS_URL
ENV EXPO_PUBLIC_SITE_URL=$EXPO_PUBLIC_SITE_URL
ENV EXPO_PUBLIC_DEMO_MODE=$EXPO_PUBLIC_DEMO_MODE

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:web

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
