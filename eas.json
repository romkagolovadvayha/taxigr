{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DISTRIBUTION_STORE": "internal"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_DISTRIBUTION_STORE": "google-play"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "app-store": {
      "extends": "production",
      "credentialsSource": "local",
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_DISTRIBUTION_STORE": "app-store"
      }
    },
    "ios-review-qa": {
      "extends": "app-store",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "config": "ios-review-qa.yml"
      }
    },
    "rustore": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_DISTRIBUTION_STORE": "rustore"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "app-store": {
      "ios": {
        "ascAppId": "6834034004",
        "appleTeamId": "GJVRBGFVG5",
        "ascApiKeyPath": "./credentials/apple/app-store-connect.p8",
        "ascApiKeyId": "JZX48RRLU7",
        "ascApiKeyIssuerId": "54422ecf-7ee1-441d-887b-315cbdc5f315"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play/service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
