PUBLIC_URL=https://taxigr.ru
EXPO_PUBLIC_API_URL=https://api.taxigr.ru
EXPO_PUBLIC_SOCKET_URL=https://api.taxigr.ru
EXPO_PUBLIC_SITE_URL=https://taxigr.ru
EXPO_PUBLIC_DEMO_MODE=false
PORT=4100
HOST=127.0.0.1
NODE_ENV=production
CORS_ORIGINS=https://taxigr.ru

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_PASSWORD=replace-with-strong-app-password
JWT_SECRET=replace-with-at-least-32-cryptographically-random-characters

SUPERADMIN_PHONES=

YANDEX_MAPS_API_KEY=
ROUTER_BASE_URL=http://osrm:5000
ROUTER_TIMEOUT_MS=2500
ROUTER_CACHE_TTL_SECONDS=600
ROUTER_CACHE_MAX_ENTRIES=2000
ROUTER_CIRCUIT_BREAKER_SECONDS=30
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_CACHE_TTL_DAYS=30
EXPO_ACCESS_TOKEN=
EAS_PROJECT_ID=

# Required SMS fallback for phone confirmation in production.
SMS_PROVIDER=notificore
NOTIFICORE_API_KEY=
# Optional ready-to-use API v2 token. If empty, the server obtains it using the API key.
NOTIFICORE_BEARER_TOKEN=
NOTIFICORE_TEMPLATE_ID=271
# Optional approved sender name in Notificore (up to 11 characters).
NOTIFICORE_ORIGINATOR=

# Required for primary phone confirmation through MAX.
MAX_BOT_USERNAME=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# Required for phone confirmation through Telegram.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=-1004215180973
TELEGRAM_CRITICAL_CHAT_ID=-1004442605510
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_UPDATE_MODE=polling
# Authenticated HTTP(S) proxy used only for outgoing Telegram Bot API calls.
TELEGRAM_PROXY_URL=

# Required for VK ID and the VK community bot.
VK_APP_ID=
VK_REDIRECT_URI=https://api.taxigr.ru/v1/auth/vk/callback
VK_COMMUNITY_ID=
VK_BOT_TOKEN=
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION=
VK_CALLBACK_URL=https://api.taxigr.ru/v1/webhooks/vk
VK_API_VERSION=5.199
PHONE_CODE_TTL_MINUTES=10
PHONE_CODE_RESEND_SECONDS=180
TRUST_PROXY_HOPS=1
AUTH_ATTEMPT_RETENTION_DAYS=30
GLOBAL_RATE_LIMIT_MAX=10000

# Required public legal details.
EXPO_PUBLIC_OPERATOR_LEGAL_NAME=
EXPO_PUBLIC_OPERATOR_STATUS=
EXPO_PUBLIC_OPERATOR_INN=
EXPO_PUBLIC_OPERATOR_REGISTRATION_NUMBER=
EXPO_PUBLIC_OPERATOR_ADDRESS=
EXPO_PUBLIC_OPERATOR_EMAIL=support@taxigr.ru
EXPO_PUBLIC_OPERATOR_PHONE=
EXPO_PUBLIC_TAXI_REGISTRY_NUMBER=
