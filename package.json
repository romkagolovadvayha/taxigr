  "scripts": {
    "start": "expo start",
    "dev": "concurrently -n app,api -c yellow,green \"npm:start\" \"npm:server\"",
    "server": "node scripts/run-server-with-ca.mjs watch server/index.ts",
    "server:start": "node scripts/run-server-with-ca.mjs server/index.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:watch": "vitest",
    "build:web": "node scripts/build-web-production.mjs",
    "build:web:local": "expo export --platform web",
    "check": "npm run typecheck && npm run test && npm run lint && npm run build:web",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:seed": "tsx server/scripts/seed.ts",
    "icons:generate": "node scripts/generate-brand-assets.mjs",
    "vk:callback:configure": "node scripts/configure-vk-callback.mjs",
