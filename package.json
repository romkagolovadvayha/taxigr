  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "dev": "concurrently -n app,api -c yellow,green \"npm:start\" \"npm:server\"",
    "server": "node scripts/run-server-with-ca.mjs watch server/index.ts",
    "server:start": "node scripts/run-server-with-ca.mjs server/index.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:store-review": "tsx server/scripts/check-store-review-auth.ts",
    "test": "vitest run",
    "release:available": "tsx server/scripts/publish-app-release.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:watch": "vitest",
    "build:web": "node scripts/build-web-production.mjs",
    "build:web:local": "expo export --platform web",
    "check": "npm run typecheck && npm run test && npm run lint && npm run build:web",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:addresses": "tsx server/scripts/import-address-directory.ts",
    "addresses:osm": "tsx scripts/import-grahovo-house-points.ts",
    "telegram:webhook:register": "node scripts/run-server-with-ca.mjs server/scripts/register-telegram-webhook.ts",
    "icons:generate": "node scripts/generate-brand-assets.mjs",
    "vk:callback:configure": "node scripts/configure-vk-callback.mjs",
    "sounds:generate": "node scripts/generate-notification-sounds.mjs"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
